{
  "private": true,
  "name": "modvitals",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "mise run build",
    "build:analyze": "mise run build:analyze",
    "build:timed": "mise run build:timed",
    "deploy": "mise run deploy",
    "dev": "mise run dev",
    "launch": "mise run launch",
    "login": "mise run login",
    "test": "mise run test",
    "test:timed": "mise run test:timed",
    "type-check": "mise run type-check",
    "lint": "mise run lint",
    "lint:fix": "mise run lint:fix",
    "lint:check": "mise run lint",
    "format": "mise run format",
    "format:check": "mise run format:check",
    "knip": "mise run knip",
    "knip:check": "mise run knip:check",
    "jscpd": "mise run jscpd",
    "quality": "mise run quality",
    "size": "mise run size",
    "size:check": "mise run size:check",
    "prepare": "husky",
    "docs": "mise run docs",
    "docs:generate": "mise run docs:generate",
    "release:changelog": "mise run release:changelog"
  },
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.2.0"
  },
  "dependencies": {
    "@devvit/start": "0.12.24",
    "@devvit/web": "0.12.24",
    "@hono/node-server": "2.0.3",
    "devvit": "0.12.24",
    "hono": "4.12.21",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/preset-small-lib": "^11.1.0",
    "@types/node": "^22.19.19",
    "depcheck": "^1.4.7",
    "eslint": "^9.12.0",
    "husky": "^9.1.6",
    "jscpd": "^4.0.5",
    "knip": "^5.27.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^6.0.3",
    "size-limit": "^11.1.0",
    "tsx": "^4.22.3",
    "typedoc": "^0.28.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.10.0",
    "vite": "8.0.13",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "src/**/*.{ts,js,json}": [
      "eslint --fix",
      "prettier --write"
