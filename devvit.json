{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "mod-vitals",
  "version": "0.1.0",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "index.html"
      }
    }
  },
  "media": {
    "dir": "public"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "scope": "moderator"
    }
  },
  "triggers": {
    "onPostSubmit": "/internal/triggers/post-submit",
    "onCommentCreate": "/internal/triggers/comment-create",
    "onModAction": "/internal/triggers/mod-action"
  },
  "scheduler": {
    "tasks": {
      "generate-report": {
        "endpoint": "/internal/scheduler/generate-report",
        "cron": "0 12 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
