{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/server/index.ts", "src/server/server.ts"],
  "project": ["src/**/*.ts"],
  "ignore": ["src/**/*.test.ts"],
  "ignoreDependencies": [
    "depcheck",
    "size-limit",
    "rollup-plugin-visualizer",
    "@size-limit/preset-small-lib",
    "jscpd",
    "typedoc",
    "pino-pretty",
    "@playwright/test"
  ],
  "ignoreBinaries": ["mise"],
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "unlisted": "error",
    "binaries": "warn",
    "unresolved": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "warn",
    "nsTypes": "warn",
    "duplicates": "warn",
    "enumMembers": "warn",
    "classMembers": "warn"
  }
}
